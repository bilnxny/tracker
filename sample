<script>
/* ═══════════════════════════════════════════════════════════
   AGENT_SUDO // AUTO_FILL
   Slot & batch parsed from pasted data — no dropdowns
   ═══════════════════════════════════════════════════════════ */

/* ── MATRIX RAIN ── */
(function(){
  const cvs=document.getElementById('matrix'),ctx=cvs.getContext('2d');
  let W,H,cols,drops;
  const chars='アカサタナハマヤラワｱｲｳｴｵ0123456789ABCDEFabcdef<>[]{}#$%&*/\\|=+';
  const fs=14;
  function resize(){W=cvs.width=innerWidth;H=cvs.height=innerHeight;cols=Math.floor(W/fs);drops=Array(cols).fill(1);}
  function draw(){
    ctx.fillStyle='rgba(2,4,10,0.08)';ctx.fillRect(0,0,W,H);
    ctx.fillStyle='#00ffa3';ctx.font=fs+'px JetBrains Mono, monospace';
    for(let i=0;i<cols;i++){
      ctx.fillText(chars[Math.floor(Math.random()*chars.length)],i*fs,drops[i]*fs);
      if(drops[i]*fs>H&&Math.random()>0.975)drops[i]=0;
      drops[i]++;
    }
  }
  resize();addEventListener('resize',resize);setInterval(draw,55);
})();

/* ── ENTRY IDS ── */
const FORM_URL='https://docs.google.com/forms/d/e/1FAIpQLSfeThWnudmLHyZvzd7euNRls4Yko4SLvtYSHr_lEdsrseKDKg/viewform';
const ID={
  tutor:'entry.301464598',
  year:'entry.1016980109_year',
  month:'entry.1016980109_month',
  day:'entry.1016980109_day',
  slot:'entry.704430059',
  code:'entry.256369685',
  batch:'entry.2048472714'
};

const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

function toast(msg,type=''){
  const el=document.createElement('div');el.className='toast '+type;el.textContent=msg;
  $('#toastWrap').appendChild(el);
  setTimeout(()=>{el.style.opacity=0;el.style.transform='translateX(30px)';},2400);
  setTimeout(()=>el.remove(),2900);
}

/* ── DATE PARSER ── */
function parseDate(str){
  if(!str)return null;
  str=String(str).trim();
  // ISO: 2026-07-24
  let m=str.match(/(\d{4})-(\d{1,2})-(\d{1,2})/);
  if(m)return {y:+m[1],m:+m[2],d:+m[3]};
  // Long: Fri Jul 24 2026 00:00:00 GMT+0530
  m=str.match(/([A-Za-z]{3,})\s+(\d{1,2})\s+(\d{4})/);
  if(m){
    const months={jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
    const mm=months[m[1].slice(0,3).toLowerCase()];
    if(mm)return {y:+m[3],m:mm,d:+m[2]};
  }
  // dd/mm/yyyy or dd-mm-yyyy
  m=str.match(/(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/);
  if(m)return {y:+m[3],m:+m[2],d:+m[1]};
  return null;
}
function isoDate(p){return `${p.y}-${String(p.m).padStart(2,'0')}-${String(p.d).padStart(2,'0')}`;}

/* ── SLOT DETECTOR ── */
function looksLikeSlot(s){
  if(!s)return false;
  const t=String(s).trim();
  if(/^\d{1,2}\s*(am|pm)\s*to\s*\d{1,2}\s*(am|pm)$/i.test(t))return true;
  if(/^\d{1,2}[:.]\d{2}\s*(am|pm)?\s*(to|-)\s*\d{1,2}[:.]\d{2}\s*(am|pm)?$/i.test(t))return true;
  if(/saturday/i.test(t))return true;
  return false;
}

/* ── BATCH DETECTOR ── */
function looksLikeBatch(s){
  if(!s)return false;
  return /^[A-F]$/i.test(String(s).trim());
}

/* ── BUILD URL ── */
function buildUrl({tutor,date,slot,code,batch}){
  const p=parseDate(date);
  if(!p)return '';
  const params=new URLSearchParams();
  params.set(ID.tutor,tutor);
  params.set(ID.year,p.y);
  params.set(ID.month,p.m);
  params.set(ID.day,p.d);
  params.set(ID.slot,slot);
  params.set(ID.code,code);
  params.set(ID.batch,batch);
  return `${FORM_URL}?${params.toString()}`;
}

/* ── PARSE INPUT — extracts date, slot, batch per line ── */
function parseInput(text){
  const lines=text.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
  const out=[];
  const seen=new Set();

  lines.forEach(line=>{
    // Split by tab first, then comma, then pipe
    let parts;
    if(line.includes('\t')) parts=line.split('\t');
    else if(line.includes(',')) parts=line.split(',');
    else if(line.includes('|')) parts=line.split('|');
    else parts=line.split(/\s{2,}/);   // fallback: 2+ spaces

    parts=parts.map(p=>p.trim()).filter(Boolean);

    let dateStr=null,slot=null,batch=null;

    for(const p of parts){
      if(!dateStr){
        const d=parseDate(p);
        if(d){dateStr=isoDate(d);continue;}
      }
      if(!slot && looksLikeSlot(p)){slot=p;continue;}
      if(!batch && looksLikeBatch(p)){batch=p.toUpperCase();continue;}
    }

    if(!dateStr)return;

    // Defaults if not found
    slot=slot||'12 pm to 2 pm';
    batch=batch||'A';

    const key=dateStr+'|'+slot+'|'+batch;
    if(seen.has(key))return;
    seen.add(key);

    out.push({date:dateStr,slot,batch});
  });

  return out;
}

let generated=[];

/* ── RENDER ── */
function render(){
  const area=$('#urlArea');
  if(!generated.length){
    area.innerHTML=`<div class="empty">
      <div class="ei">📭</div>
      <h3>// no_buttons_yet</h3>
      <p>Paste data on the left and click GENERATE_BUTTONS</p>
    </div>`;
    updateStats();
    return;
  }

  area.innerHTML=`<div class="url-list">${generated.map((u,i)=>`
    <div class="url-item ${u.opened?'opened':''}" data-idx="${i}">
      <div class="url-head">
        <span class="url-num-badge">#${i+1}</span>
        <span class="url-date">${esc(u.date)}</span>
        <span class="url-meta">${esc(u.slot)}</span>
        <span class="url-meta">batch ${esc(u.batch)}</span>
        <span class="url-meta" style="color:var(--accent)">${esc(u.code)}</span>
        ${u.opened?'<span class="url-check">✓ DONE</span>':''}
      </div>
      <div class="url-actions">
        <a class="submit-big" href="${esc(u.url)}" target="_blank" rel="noopener" data-open="${i}">
          ${u.opened?'✓ OPEN_AGAIN':'⚡ SUBMIT #'+(i+1)}
        </a>
        <button class="btn ghost small" data-copy="${esc(u.url)}">⧉ URL</button>
        <button class="btn ghost small" data-copydate="${esc(u.date)}">⧉ DATE</button>
      </div>
    </div>
  `).join('')}</div>`;

  $$('#urlArea [data-open]').forEach(a=>a.addEventListener('click',()=>{
    const i=+a.dataset.open;
    if(generated[i]){generated[i].opened=true;setTimeout(render,250);}
  }));
  $$('#urlArea [data-copy]').forEach(b=>b.addEventListener('click',async()=>{
    try{await navigator.clipboard.writeText(b.dataset.copy);toast('URL copied ✓','ok');}
    catch{toast('Copy failed','error');}
  }));
  $$('#urlArea [data-copydate]').forEach(b=>b.addEventListener('click',async()=>{
    try{await navigator.clipboard.writeText(b.dataset.copydate);toast('Date copied','ok');}
    catch{toast('Copy failed','error');}
  }));

  updateStats();
}

function updateStats(){
  const t=generated.length;
  const o=generated.filter(u=>u.opened).length;
  $('#statTotal').textContent=t;
  $('#statOpened').textContent=o;
  $('#statLeft').textContent=t-o;
  const pct=t?Math.round((o/t)*100):0;
  $('#progressBar').style.width=pct+'%';
}

/* ── GENERATE ── */
$('#generateBtn').addEventListener('click',()=>{
  const tutor=$('#fTutor').value.trim();
  const code=$('#fCode').value.trim();
  const raw=$('#fData').value;

  if(!tutor)return toast('Tutor number required','error');
  if(!code)return toast('Chapter code required','error');
  if(!raw.trim())return toast('Paste at least one line of data','warn');

  const rows=parseInput(raw);
  if(!rows.length)return toast('No valid dates found — check format','error');

  generated=rows.map(r=>({
    date:r.date,slot:r.slot,batch:r.batch,code,tutor,
    url:buildUrl({tutor,date:r.date,slot:r.slot,code,batch:r.batch}),
    opened:false
  }));

  render();
  $('#urlInfo').innerHTML=`✓ Generated <b style="color:var(--accent)">${generated.length}</b> submit buttons`;
  toast(`Generated ${generated.length} buttons ✓`,'ok');
});

/* ── SUBMIT NEXT (one tab at a time) ── */
$('#openNextBtn').addEventListener('click',()=>{
  const next=generated.find(u=>!u.opened);
  if(!next)return toast('All entries submitted ✓','ok');
  window.open(next.url,'_blank');
  next.opened=true;
  setTimeout(render,250);
  const left=generated.filter(u=>!u.opened).length;
  toast(`Opened ${next.date} — ${left} left`,'ok');
});

/* ── COPY ALL ── */
$('#copyAllBtn').addEventListener('click',async()=>{
  if(!generated.length)return toast('Generate buttons first','warn');
  const text=generated.map((u,i)=>`#${i+1}\t${u.date}\t${u.slot}\t${u.batch}\t${u.code}\t${u.tutor}\t${u.url}`).join('\n');
  try{await navigator.clipboard.writeText(text);toast('All copied ✓','ok');}
  catch{toast('Copy failed','error');}
});

/* ── RESET ── */
$('#resetBtn').addEventListener('click',()=>{
  if(!confirm('Reset all opened marks?'))return;
  generated.forEach(u=>u.opened=false);
  render();
  toast('Reset ✓','ok');
});

/* ── INIT ── */
$('#year').textContent=new Date().getFullYear();
render();
</script>
</body>
