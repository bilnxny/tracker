<style>
:root{
  --bg:#02040a;--bg2:#05080f;--panel:#0a1120;--panel2:#0d1626;
  --border:#152340;--border2:#1e3358;--text:#d6e8ff;--muted:#7d93b3;--dim:#3d5273;
  --accent:#00ffa3;--accent2:#00c2ff;--danger:#ff3d6e;--warn:#ffb020;--ok:#00ff88;
  --mono:'JetBrains Mono',ui-monospace,monospace;--sans:'Inter',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:var(--sans);font-size:14px;line-height:1.55;min-height:100vh;-webkit-font-smoothing:antialiased;position:relative;overflow-x:hidden}
#matrix{position:fixed;inset:0;z-index:0;opacity:.1;pointer-events:none}
.scanlines{position:fixed;inset:0;z-index:1;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,255,163,.015) 0px,rgba(0,255,163,.015) 1px,transparent 1px,transparent 3px);mix-blend-mode:overlay}
body::before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;
  background:radial-gradient(700px 400px at 10% -10%,rgba(0,255,163,.13),transparent 60%),
             radial-gradient(900px 500px at 90% 0%,rgba(0,194,255,.09),transparent 60%)}
::-webkit-scrollbar{width:9px;height:9px}::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:#1c2c48;border-radius:5px;border:2px solid var(--bg2)}
::selection{background:rgba(0,255,163,.35);color:#fff}
a{color:var(--accent2);text-decoration:none}

.topbar{position:sticky;top:0;z-index:40;display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  padding:14px 22px;background:rgba(2,4,10,.88);backdrop-filter:blur(18px);border-bottom:1px solid var(--border)}
.brand{display:flex;align-items:center;gap:12px}
.logo{width:42px;height:42px;border-radius:11px;display:grid;place-items:center;font-family:var(--mono);
  font-weight:700;font-size:15px;color:#02130d;background:linear-gradient(135deg,var(--accent),var(--accent2));
  box-shadow:0 0 22px -4px rgba(0,255,163,.7);animation:logoPulse 3s ease-in-out infinite}
@keyframes logoPulse{0%,100%{box-shadow:0 0 22px -4px rgba(0,255,163,.7)}50%{box-shadow:0 0 32px -2px rgba(0,255,163,.9)}}
.brand h1{font-size:16px;font-weight:800;font-family:var(--mono);letter-spacing:-.3px}
.brand h1 span{color:var(--accent);text-shadow:0 0 12px rgba(0,255,163,.7)}
.brand small{font-size:10px;color:var(--muted);letter-spacing:1.2px;text-transform:uppercase;font-family:var(--mono)}
.top-actions{margin-left:auto;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.dev-badge{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11.5px;
  color:var(--accent);padding:7px 12px;border-radius:9px;border:1px solid rgba(0,255,163,.35);
  background:rgba(0,255,163,.06);text-shadow:0 0 8px rgba(0,255,163,.5)}
.dev-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent);
  box-shadow:0 0 8px var(--accent);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.8)}}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:10px 16px;border-radius:9px;
  font-family:var(--mono);font-size:12.5px;font-weight:700;cursor:pointer;border:1px solid transparent;
  transition:all .18s;white-space:nowrap;user-select:none;letter-spacing:.3px}
.btn.primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#02130d;box-shadow:0 4px 18px -6px rgba(0,255,163,.7)}
.btn.primary:hover{filter:brightness(1.12);transform:translateY(-1px)}
.btn.primary:disabled{opacity:.5;cursor:not-allowed;transform:none}
.btn.outline{background:transparent;color:var(--accent);border-color:rgba(0,255,163,.4)}
.btn.outline:hover{background:rgba(0,255,163,.08);border-color:var(--accent)}
.btn.ghost{background:var(--panel);color:var(--muted);border-color:var(--border)}
.btn.ghost:hover{color:var(--text);border-color:var(--border2);background:var(--panel2)}
.btn.danger{color:var(--danger);border-color:rgba(255,61,110,.35)}
