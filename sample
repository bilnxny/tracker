.entry-ids{display:grid;grid-template-columns:1fr 1fr;gap:6px;font-family:var(--mono);font-size:10px;
  background:var(--bg2);border:1px solid var(--border);border-radius:9px;padding:10px;color:var(--muted)}
.entry-ids b{color:var(--accent);font-weight:700;display:block;font-size:9px;text-transform:uppercase;letter-spacing:.8px;margin-bottom:2px}
.entry-ids span{color:var(--accent2);word-break:break-all;font-size:9.5px}

.toast-wrap{position:fixed;bottom:20px;right:20px;z-index:200;display:flex;flex-direction:column;gap:8px;pointer-events:none}
.toast{background:linear-gradient(135deg,#0a1120,#05080f);border:1px solid var(--border2);
  border-left:3px solid var(--accent);border-radius:9px;padding:11px 15px;color:var(--text);font-size:12px;
  font-family:var(--mono);box-shadow:0 20px 60px -20px rgba(0,0,0,.9),0 0 20px -4px rgba(0,255,163,.3);
  animation:tin .25s ease;max-width:320px;pointer-events:auto}
.toast.error{border-left-color:var(--danger)}
.toast.warn{border-left-color:var(--warn)}
.toast.ok{border-left-color:var(--ok)}
@keyframes tin{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:translateX(0)}}

.footer{padding:20px;border-top:1px solid var(--border);color:var(--dim);font-size:11px;text-align:center;
  font-family:var(--mono);position:relative;z-index:2;letter-spacing:.5px}
.footer .dev{color:var(--accent);font-weight:700;text-shadow:0 0 8px rgba(0,255,163,.5)}
</style>
