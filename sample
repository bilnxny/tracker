.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.stat{background:var(--bg2);border:1px solid var(--border);border-radius:9px;padding:10px;text-align:center}
.stat .n{font-family:var(--mono);font-size:20px;font-weight:800;color:var(--accent);text-shadow:0 0 12px rgba(0,255,163,.5)}
