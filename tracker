<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>CipherVault — Secure Knowledge Base</title>
<meta name="description" content="CipherVault — cybersecurity-themed knowledge base with sheet view and teaching tracker." />
<meta name="theme-color" content="#04060b" />
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛡️</text></svg>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="styles.css" />
</head>
<body>

<div class="bg-grid" aria-hidden="true"></div>
<div class="bg-glow" aria-hidden="true"></div>

<!-- ══════════ TOP BAR ══════════ -->
<header class="topbar">
  <div class="brand">
    <div class="logo">&lt;/&gt;</div>
    <div class="brand-text">
      <h1>Cipher<span>Vault</span></h1>
      <small>Secure Knowledge Base</small>
    </div>
  </div>

  <div class="search-box">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    </svg>
    <input id="searchInput" type="search" placeholder="Search topics, sub-chapters, code…" autocomplete="off" />
    <kbd class="kbd">/</kbd>
  </div>

  <div class="top-actions">
    <a class="contact" href="tel:7306227436" title="Tutor contact">
      <span class="pulse"></span> 7306227436
    </a>
    <a class="btn primary" id="submitFormBtn" target="_blank" rel="noopener"
       href="https://docs.google.com/forms/d/e/1FAIpQLSfeThWnudmLHyZvzd7euNRls4Yko4SLvtYSHr_lEdsrseKDKg/viewform">
      ⚡ Submit to Sheet
    </a>
    <button class="btn outline" id="addTopicBtn">+ New Topic</button>
  </div>
</header>

<!-- ══════════ LAYOUT ══════════ -->
<main class="layout">

  <aside class="sidebar">
    <div class="side-head">
      <span>Topics</span>
      <span class="count-badge" id="topicCount">0</span>
    </div>
    <nav class="topic-list" id="topicList"></nav>
    <div class="side-foot">
      <button class="btn ghost full" id="exportBtn">⤓ Export JSON</button>
      <button class="btn ghost full" id="importBtn">⤒ Import JSON</button>
      <button class="btn ghost full danger" id="resetBtn">⟲ Reset Data</button>
      <input type="file" id="importFile" accept="application/json" hidden />
    </div>
  </aside>

  <section class="content" id="content"></section>

</main>

<footer class="footer">
  <span>CipherVault © <span id="year"></span> — Built for secure knowledge tracking</span>
  <span class="mono">tutor · 7306227436</span>
</footer>

<!-- ══════════ MODAL : TOPIC ══════════ -->
<div class="modal-backdrop" id="topicModal" hidden>
  <div class="modal">
    <div class="modal-head">
      <h3 id="topicModalTitle">New Topic</h3>
      <button class="btn icon" data-close aria-label="Close">✕</button>
    </div>
    <div class="modal-body">
      <label class="field">
        <span>Topic Name *</span>
        <input id="tName" placeholder="e.g. Ethical Hacking" autocomplete="off" />
      </label>
      <div class="grid-2">
        <label class="field">
          <span>Icon (emoji)</span>
          <input id="tIcon" placeholder="🛡️" maxlength="6" autocomplete="off" />
        </label>
        <label class="field">
          <span>Accent Colour</span>
          <input id="tAccent" type="color" value="#00e6a8" />
        </label>
      </div>
      <label class="field">
        <span>Description</span>
        <textarea id="tDesc" rows="3" placeholder="Short description of this topic…"></textarea>
      </label>
    </div>
    <div class="modal-foot">
      <button class="btn ghost" data-close>Cancel</button>
      <button class="btn primary" id="saveTopicBtn">Save Topic</button>
    </div>
  </div>
</div>

<!-- ══════════ MODAL : SUB-CHAPTER ══════════ -->
<div class="modal-backdrop" id="subModal" hidden>
  <div class="modal wide">
    <div class="modal-head">
      <h3 id="subModalTitle">New Sub-Chapter</h3>
      <button class="btn icon" data-close aria-label="Close">✕</button>
    </div>
    <div class="modal-body">

      <div class="grid-2">
        <label class="field">
          <span>Sub Chapter Code *</span>
          <input id="sCode" placeholder="e.g. SMSC01 / EH-01" autocomplete="off" />
        </label>
        <label class="field">
          <span>Title *</span>
          <input id="sTitle" placeholder="e.g. Reconnaissance &amp; Footprinting" autocomplete="off" />
        </label>
      </div>

      <div class="grid-3">
        <label class="field">
          <span>Slot</span>
          <input id="sSlot" value="12 pm to 2 pm" autocomplete="off" />
        </label>
        <label class="field">
          <span>SubBatch</span>
          <input id="sBatch" value="a" autocomplete="off" />
        </label>
        <label class="field">
          <span>District</span>
          <input id="sDistrict" value="ernakulam" autocomplete="off" />
        </label>
      </div>

      <div class="grid-2">
        <label class="field">
          <span>Tutor Register Number</span>
          <input id="sTutor" value="7306227436" autocomplete="off" />
        </label>
        <label class="field">
          <span>Session Dates (one per line)</span>
          <textarea id="sDates" rows="3" placeholder="2026-07-24&#10;2026-07-27"></textarea>
        </label>
      </div>

      <label class="field">
        <span>Summary / Notes</span>
        <textarea id="sSummary" rows="3" placeholder="What this sub-chapter covers…"></textarea>
      </label>

      <div class="blocks-editor">
        <div class="blocks-head">
          <span>Content Blocks <em>(code, commands, notes — stored exactly as typed)</em></span>
          <button class="btn small" type="button" id="addBlockBtn">+ Add Block</button>
        </div>
        <div id="blockList"></div>
      </div>

    </div>
    <div class="modal-foot">
      <button class="btn ghost" data-close>Cancel</button>
      <button class="btn primary" id="saveSubBtn">Save Sub-Chapter</button>
    </div>
  </div>
</div>

<!-- ══════════ MODAL : TRACKER ══════════ -->
<div class="modal-backdrop" id="trackerModal" hidden>
  <div class="modal wide">
    <div class="modal-head">
      <h3>Teaching Tracker</h3>
      <button class="btn icon" data-close aria-label="Close">✕</button>
    </div>
    <div class="modal-body">

      <div class="grid-2">
        <label class="field">
          <span>Sub Chapter Code</span>
          <input id="tkCode" autocomplete="off" />
        </label>
        <label class="field">
          <span>Slot</span>
          <input id="tkSlot" value="12 pm to 2 pm" autocomplete="off" />
        </label>
      </div>

      <div class="grid-3">
        <label class="field">
          <span>SubBatch</span>
          <input id="tkBatch" value="a" autocomplete="off" />
        </label>
        <label class="field">
          <span>District</span>
          <input id="tkDistrict" value="ernakulam" autocomplete="off" />
        </label>
        <label class="field">
          <span>Tutor Register Number</span>
          <input id="tkTutor" value="7306227436" autocomplete="off" />
        </label>
      </div>

      <label class="field">
        <span>Dates — one per line, or comma separated</span>
        <textarea id="tkDates" rows="6" placeholder="2026-07-24&#10;2026-07-27&#10;2026-07-29"></textarea>
      </label>

      <details class="advanced">
        <summary>Advanced — Form URL &amp; Entry IDs</summary>
        <label class="field">
          <span>Google Form URL</span>
          <input id="tkUrl" autocomplete="off" />
        </label>
        <div class="grid-2">
          <label class="field"><span>Tutor entry</span><input id="tkE1" autocomplete="off" /></label>
          <label class="field"><span>Slot entry</span><input id="tkE2" autocomplete="off" /></label>
          <label class="field"><span>Sub Chapter entry</span><input id="tkE3" autocomplete="off" /></label>
          <label class="field"><span>SubBatch entry</span><input id="tkE4" autocomplete="off" /></label>
          <label class="field"><span>Year entry</span><input id="tkE5" autocomplete="off" /></label>
          <label class="field"><span>Month entry</span><input id="tkE6" autocomplete="off" /></label>
          <label class="field"><span>Day entry</span><input id="tkE7" autocomplete="off" /></label>
        </div>
      </details>

      <div class="row-actions">
        <button class="btn primary" id="tkGenerate">⚡ Generate Links</button>
        <button class="btn ghost" id="tkCopy">Copy TSV</button>
        <button class="btn ghost" id="tkCsv">Download CSV</button>
      </div>

      <div id="tkOutput" class="tk-output"></div>
    </div>
    <div class="modal-foot">
      <button class="btn ghost" data-close>Close</button>
    </div>
  </div>
</div>

<div class="toast-wrap" id="toastWrap"></div>

<script src="app.js"></script>
</body>
</html>
